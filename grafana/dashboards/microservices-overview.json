    {
      "title": "Peticiones HTTP por segundo (req/s)",
      "description": "Mide el rendimiento de solicitudes HTTP procesadas agrupadas por microservicio y código de estado",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job, status)",
          "legendFormat": "{{job}} [{{status}}]"
        }
      ]
    },
    {
      "title": "Uso de Memoria JVM (Heap)",
      "description": "Muestra el consumo de memoria Heap de la máquina virtual de Java expuesto por Spring Boot Actuator",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{job}} - {{id}}"
        }
      ]
    },
    {
      "title": "Kafka Consumer Lag",
      "description": "Monitorea el retraso en el procesamiento de mensajes de los consumidores de Kafka",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(kafka_consumer_fetch_manager_records_lag) by (topic, client_id) or sum(spring_kafka_listener_lag) by (topic)",
          "legendFormat": "{{topic}} ({{client_id}})"
        }
      ]
    }
  ],
